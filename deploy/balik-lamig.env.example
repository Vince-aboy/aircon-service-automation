# Copy to /etc/balik-lamig/balik-lamig.env on the VPS and restrict it to root.
# Never commit the real file or paste its values into chat.
AIRCON_DATABASE_URL=postgresql+psycopg://balik_lamig_app@127.0.0.1:5432/balik_lamig
PGPASSWORD=replace-with-the-dedicated-database-password
AIRCON_PUBLIC_BASE_PATH=/balik-lamig
AIRCON_AUTOMATIC_DELIVERY_ENABLED=false
AIRCON_OPERATION_MODE=local_prototype
# Required when AIRCON_OPERATION_MODE=live; keep these only in the protected VPS env file.
# AIRCON_STAFF_USERNAME=owner
# AIRCON_STAFF_PASSWORD=replace-with-a-long-random-password
# Add these only after the persistent n8n webhook is deliberately configured:
# AIRCON_N8N_WEBHOOK_URL=https://n8n.vinceaboy.com/webhook/...
# AIRCON_N8N_WEBHOOK_KEY=replace-with-staging-header-key
