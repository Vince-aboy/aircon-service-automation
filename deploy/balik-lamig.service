[Unit]
Description=Balik-Lamig FastAPI portfolio staging app
After=network.target postgresql.service

[Service]
Type=simple
User=aboy
Group=aboy
WorkingDirectory=/home/aboy/apps/balik-lamig
EnvironmentFile=/etc/balik-lamig/balik-lamig.env
ExecStart=/home/aboy/apps/balik-lamig/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
