[Unit]
Description=Balik-Lamig synthetic outbox delivery worker
After=network-online.target balik-lamig.service

[Service]
Type=oneshot
User=aboy
Group=aboy
WorkingDirectory=/home/aboy/apps/balik-lamig
EnvironmentFile=/etc/balik-lamig/balik-lamig.env
ExecStart=/home/aboy/apps/balik-lamig/.venv/bin/python -m app.automation_worker
NoNewPrivileges=true

